{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Fresh on-demand AML rerun. Isolated jobs/roles/temp paths; existing Catalog/workgroup reused. No processing starts on creation.",
  "Parameters": {
    "CodeVersion": {
      "Type": "String",
      "Default": "full-v6",
      "AllowedPattern": "full-v[1-9][0-9]*"
    },
    "RunId": {
      "Type": "String",
      "Default": "full-20261029-v1",
      "AllowedPattern": "[a-z][a-z0-9-]{1,60}"
    },
    "ReleaseId": {
      "Type": "String",
      "Default": "full-20261029-v1",
      "AllowedPattern": "[a-z][a-z0-9-]{1,60}"
    }
  },
  "Resources": {
    "PrepareRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "is459-aml-rerun29-prepare",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "glue.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "project-data-only",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "s3:GetBucketLocation",
                  "Resource": "arn:aws:s3:::is459-aml-g2team7-160885259244-us-east-1"
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:ListBucket",
                  "Resource": "arn:aws:s3:::is459-aml-g2team7-160885259244-us-east-1",
                  "Condition": {
                    "StringLike": {
                      "s3:prefix": [
                        "raw/full-v1*",
                        {
                          "Fn::Sub": "curated/dataset_version=ibm-hi-medium-b1b99c68b765580f/run_id=${RunId}*"
                        },
                        {
                          "Fn::Sub": "references/labels/dataset_version=ibm-hi-medium-b1b99c68b765580f/run_id=${RunId}*"
                        },
                        {
                          "Fn::Sub": "quality/preparation/dataset_version=ibm-hi-medium-b1b99c68b765580f/run_id=${RunId}*"
                        },
                        {
                          "Fn::Sub": "quarantine/preparation/dataset_version=ibm-hi-medium-b1b99c68b765580f/run_id=${RunId}*"
                        },
                        {
                          "Fn::Sub": "scripts/${CodeVersion}*"
                        },
                        "temporary/rerun29/prepare*"
                      ]
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": [
                    "arn:aws:s3:::is459-aml-g2team7-160885259244-us-east-1/raw/full-v1",
                    "arn:aws:s3:::is459-aml-g2team7-160885259244-us-east-1/raw/full-v1/*",
                    {
                      "Fn::Sub": "arn:aws:s3:::is459-aml-g2team7-160885259244-us-east-1/scripts/${CodeVersion}"
                    },
                    {
                      "Fn::Sub": "arn:aws:s3:::is459-aml-g2team7-160885259244-us-east-1/scripts/${CodeVersion}/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject",
                    "s3:AbortMultipartUpload"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:s3:::is459-aml-g2team7-160885259244-us-east-1/curated/dataset_version=ibm-hi-medium-b1b99c68b765580f/run_id=${RunId}/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:s3:::is459-aml-g2team7-160885259244-us-east-1/references/labels/dataset_version=ibm-hi-medium-b1b99c68b765580f/run_id=${RunId}/*"
