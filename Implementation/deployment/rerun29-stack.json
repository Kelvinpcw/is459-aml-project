                    },
                    "arn:aws:s3:::is459-aml-g2team7-160885259244-us-east-1/temporary/rerun29/prepare/*"
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
