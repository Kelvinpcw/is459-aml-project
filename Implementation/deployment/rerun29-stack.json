    "WorkflowRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "is459-aml-rerun29-workflow",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
