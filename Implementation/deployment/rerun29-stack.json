                    "arn:aws:glue:us-east-1:160885259244:job/is459-aml-rerun29-evaluate",
                    "arn:aws:glue:us-east-1:160885259244:job/is459-aml-rerun29-control"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "Workflow": {
      "Type": "AWS::StepFunctions::StateMachine",
      "Properties": {
        "StateMachineName": "is459-aml-rerun29-pipeline",
        "StateMachineType": "STANDARD",
        "RoleArn": {
          "Fn::GetAtt": [
            "WorkflowRole",
            "Arn"
          ]
        },
        "DefinitionString": {
          "Fn::Sub": [
            "{\"Comment\": \"On-demand AML full-data workflow; no retries or recurring schedule. Published pointer changes only after all gates.\", \"StartAt\": \"Prepare\", \"TimeoutSeconds\": 16200, \"States\": {\"Prepare\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::glue:startJobRun.sync\", \"Parameters\": {\"JobName\": \"${PrepareJob}\"}, \"ResultPath\": null, \"Next\": \"MakeManifest\", \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"Failed\"}]}, \"MakeManifest\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::glue:startJobRun.sync\", \"Parameters\": {\"JobName\": \"${ControlJob}\", \"Arguments\": {\"--phase\": \"manifests\"}}, \"ResultPath\": null, \"Next\": \"Branches\", \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"Failed\"}]}, \"Branches\": {\"Type\": \"Parallel\", \"Branches\": [{\"StartAt\": \"Risk\", \"States\": {\"Risk\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::glue:startJobRun.sync\", \"Parameters\": {\"JobName\": \"${RiskJob}\"}, \"ResultPath\": null, \"End\": true}}}, {\"StartAt\": \"Detect\", \"States\": {\"Detect\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::glue:startJobRun.sync\", \"Parameters\": {\"JobName\": \"${DetectJob}\"}, \"ResultPath\": null, \"End\": true}}}], \"ResultPath\": null, \"Next\": \"Catalog\", \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"Failed\"}]}, \"Catalog\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::glue:startJobRun.sync\", \"Parameters\": {\"JobName\": \"${ControlJob}\", \"Arguments\": {\"--phase\": \"catalog\"}}, \"ResultPath\": null, \"Next\": \"Evaluate\", \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"Failed\"}]}, \"Evaluate\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::glue:startJobRun.sync\", \"Parameters\": {\"JobName\": \"${EvaluateJob}\"}, \"ResultPath\": null, \"Next\": \"Publish\", \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"Failed\"}]}, \"Publish\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::glue:startJobRun.sync\", \"Parameters\": {\"JobName\": \"${ControlJob}\", \"Arguments\": {\"--phase\": \"publish\", \"--expected-pointer-etag.$\": \"$.expected_pointer_etag\"}}, \"ResultPath\": null, \"End\": true, \"Catch\": [{\"ErrorEquals\": [\"States.ALL\"], \"ResultPath\": \"$.failure\", \"Next\": \"Failed\"}]}, \"Failed\": {\"Type\": \"Fail\", \"Error\": \"PipelineFailed\", \"Cause\": \"A required stage failed. Prior published release is retained; choose a new attempt after diagnosis.\"}}}",
            {
              "PrepareJob": {
                "Ref": "PrepareJob"
              },
              "RiskJob": {
                "Ref": "RiskJob"
              },
              "DetectJob": {
                "Ref": "DetectJob"
              },
              "EvaluateJob": {
                "Ref": "EvaluateJob"
              },
              "ControlJob": {
                "Ref": "ControlJob"
              }
            }
          ]
        }
      }
    }
  },
