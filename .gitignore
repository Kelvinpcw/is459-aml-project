# The 3GB IBM dataset lives on Kaggle/local disk - never in git
Ibm_dataset_medium/

# Share confirmed requirements and architecture, not old drafts/Word copies
/Proposal/*
!/Proposal/Project_Proposal.md
!/Proposal/assets/
!/Proposal/Architecture/
/Proposal/Architecture/*
!/Proposal/Architecture/Pipeline_Explanation.md
!/Proposal/Architecture/Detailed/
!/Proposal/Architecture/Simplified/
/Proposal/Architecture/Simplified/AWS_Architecture_Pack2.pdf
/\[IS459\] Project_G2.pptx
/other.txt

# Machine-local credentials and environment settings must never be committed
.env
.env.*
!.env.example
.aws/

# Regenerable slices, replays and cloud copies live in S3 or local disk
Implementation/data/

# Data artifacts
*.csv
*.csv.gz
*.parquet

# Python
__pycache__/
*.pyc
.venv/

# OS noise
.DS_Store
Icon*
